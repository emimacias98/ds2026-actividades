{
  "name": "libreria-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node src/index.js",
    "start:dev": "prisma generate && prisma migrate deploy && npm run prisma:seed && npm run dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio --hostname 0.0.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "prisma": "^6.14.0",
    "tsx": "^4.20.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}