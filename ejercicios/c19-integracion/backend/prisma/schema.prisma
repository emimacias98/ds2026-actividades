generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  CLIENTE
}

model Usuario {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  nombre       String
  rol          Rol    @default(CLIENTE)
}

model Autor {
  id           Int     @id @default(autoincrement())
  nombre       String  @unique
  nacionalidad String
  nacimiento   Int
  libros       Libro[]
}

model Libro {
  id          Int         @id @default(autoincrement())
  titulo      String
  precio      Int
  imagen      String
  descripcion String
  disponible  Boolean     @default(true)
  autorId     Int
  autor       Autor       @relation(fields: [autorId], references: [id], onDelete: Restrict)
  categorias  Categoria[]
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  libros Libro[]
}